#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
python3 "$REPO_ROOT/guard/failure_mode_catalog_guard.py"

# Derived artifacts only need regeneration when a canonical input changed.
# This hook is also called directly by add-failure-mode.sh after its write; in
# that path the working-tree diff makes the full loop run before success.
if git -C "$REPO_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
    && git -C "$REPO_ROOT" diff --quiet -- catalog/failure-modes.md catalog/id-ledger.txt \
    && git -C "$REPO_ROOT" diff --cached --quiet -- catalog/failure-modes.md catalog/id-ledger.txt; then
    exit 0
fi

python3 "$REPO_ROOT/pipeline/extract_mechanical.py"
python3 "$REPO_ROOT/pipeline/cluster.py"
python3 "$REPO_ROOT/pipeline/reconcile_l1.py"

GENERATED=(
    pipeline/L1/homelab-canon.jsonl
    pipeline/L1/fleet-dispatch-schema.jsonl
    pipeline/L2/clusters.jsonl
)
if git -C "$REPO_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
    && ! git -C "$REPO_ROOT" diff --quiet -- "${GENERATED[@]}"; then
    echo "ERROR: ingest regenerated required artifacts that are not staged." >&2
    echo "Stage these exact files, review them, and retry the commit:" >&2
    printf '  %s\n' "${GENERATED[@]}" >&2
    exit 1
fi
