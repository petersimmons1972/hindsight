#!/usr/bin/env bash
set -euo pipefail

if ! REPO_ROOT="$(git rev-parse --show-toplevel)"; then
    echo "ERROR: pre-commit must run from inside the worktree being committed." >&2
    exit 1
fi
python3 "$REPO_ROOT/guard/failure_mode_catalog_guard.py"

# Plan-index truth (issue #92): load-bearing when the index or its evidence
# inputs are staged. Catalog-only commits skip this to stay cheap; a silent
# green index is the failure mode this call exists to catch.
INDEX_INPUTS=(
    plans/00-INDEX.md
    docs/DECISIONS.md
    conf/plan-index-expected-ids.conf
)
if git -C "$REPO_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    index_touched=0
    for f in "${INDEX_INPUTS[@]}"; do
        if ! git -C "$REPO_ROOT" diff --quiet --cached -- "$f" 2>/dev/null \
            || ! git -C "$REPO_ROOT" diff --quiet -- "$f" 2>/dev/null; then
            index_touched=1
            break
        fi
    done
    if (( index_touched )); then
        echo "pre-commit: running check-plan-index-truth.sh (index inputs staged or dirty)"
        bash "$REPO_ROOT/bin/check-plan-index-truth.sh"
    fi
fi

# Derived artifacts only need regeneration when a canonical input changed.
# This hook is also called directly by add-failure-mode.sh after its write; in
# that path the working-tree diff makes the full loop run before success.
# This used to be an early `exit 0` for the whole hook when the catalog was
# unchanged -- wrapped in an `if` instead so the criticality.jsonl / pointer-
# file check below always runs too, independent of whether the catalog itself
# changed in this commit.
if git -C "$REPO_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
    && { ! git -C "$REPO_ROOT" diff --quiet -- catalog/failure-modes.md catalog/id-ledger.txt \
         || ! git -C "$REPO_ROOT" diff --cached --quiet -- catalog/failure-modes.md catalog/id-ledger.txt; }; then
    python3 "$REPO_ROOT/pipeline/extract_mechanical.py"
    # Reconcile ONLY the two L1 sources the regeneration above actually writes --
    # the same two named in GENERATED below. The unscoped run also reads four
    # sibling repos this commit never touched, so a backlog in any of them made
    # EVERY commit that changed the catalog impossible (issue #73). A scoped run
    # prints the sources it skipped, so the narrowing is never silent.
    #
    # CI (guard.yml) reconciles homelab-canon only -- the one source its runner
    # checks out. fleet-dispatch-schema is scoped here for this hook's own
    # regenerated-artifact check, but CI does NOT verify it, and CI does NOT
    # verify fleet-main, fleet-orch, or claude-codex-integration either. There is
    # no unscoped run left that humans or CI use for corpus-wide drift; that gap
    # is a known, ledgered limitation, not something this hook or CI covers.
    python3 "$REPO_ROOT/pipeline/reconcile_l1.py" \
        --source homelab-canon --source fleet-dispatch-schema

    # L2 is released by add-failure-mode.sh's controlled snapshot transaction.
    # Never regenerate it here through the live embedding backend: replay the
    # released snapshot after L1 extraction and reject any provenance or
    # partition mismatch instead.
    if ! REPLAY_OUTPUT="$(python3 "$REPO_ROOT/pipeline/replay_l2.py")"; then
        echo "ERROR: regenerated L2 artifacts do not replay from the committed embedding snapshot." >&2
        exit 1
    fi
    if [[ "$REPLAY_OUTPUT" != "replay-l2: PASS:"* ]]; then
        echo "ERROR: pipeline/replay_l2.py did not report replay-l2: PASS:." >&2
        exit 1
    fi

    GENERATED=(
        pipeline/L1/homelab-canon.jsonl
        pipeline/L1/fleet-dispatch-schema.jsonl
        pipeline/L2/embedding-snapshot.json
        pipeline/L2/clusters.jsonl
    )
    if ! git -C "$REPO_ROOT" diff --quiet -- "${GENERATED[@]}"; then
        echo "ERROR: ingest regenerated required artifacts that are not staged." >&2
        echo "Stage these exact files, review them, and retry the commit:" >&2
        printf '  %s\n' "${GENERATED[@]}" >&2
        exit 1
    fi
fi

# docs/POINTER.md and docs/HIGH.md are derived from catalog/criticality.jsonl
# by bin/synthesize-pointer.py. add-failure-mode.sh already regenerates them
# on every canonical write, but a hand-edit of criticality.jsonl (or a commit
# that forgot to re-stage the regenerated files) would otherwise let them
# drift silently -- this is the same "regenerate and diff" pattern as
# GENERATED above, scoped to criticality.jsonl instead of the catalog.
if git -C "$REPO_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
    && { ! git -C "$REPO_ROOT" diff --quiet -- catalog/criticality.jsonl \
         || ! git -C "$REPO_ROOT" diff --cached --quiet -- catalog/criticality.jsonl; }; then
    python3 "$REPO_ROOT/bin/synthesize-pointer.py"
    POINTER_GENERATED=(docs/POINTER.md docs/HIGH.md)
    if ! git -C "$REPO_ROOT" diff --quiet -- "${POINTER_GENERATED[@]}"; then
        echo "ERROR: catalog/criticality.jsonl changed but docs/POINTER.md / docs/HIGH.md are stale." >&2
        echo "Stage these exact files, review them, and retry the commit:" >&2
        printf '  %s\n' "${POINTER_GENERATED[@]}" >&2
        exit 1
    fi
fi
